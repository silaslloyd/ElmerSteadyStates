// Flowline footprint ending at the steady ice margin (fixed-margin mode: [case] x_end < 1),
// one element wide, refined towards the end. Values are filled in by `ess setup`; Lend = x_end * L.
// The physical-group order (inflow, front, side1, side2) gives Elmer boundaries 1-4, which the
// extruded mesh and steady_template.sif rely on. The entities are taken from what Extrude returns
// (top curve, surface, lateral curves at the start and end point), not from gmsh's numbering.
Lend = {Lend};
W = {Wmesh};
resb = {BoundaryRes};
resm = {MarginRes};
Point(1) = {0, 0, 0, resb};
Point(2) = {Lend*(1-1/8), 0, 0, resm};
Point(3) = {Lend*(1-1/32), 0, 0, resm/2};
Point(4) = {Lend, 0, 0, resm/2};
Line(1) = {1, 2};
Line(2) = {2, 3};
Line(3) = {3, 4};
e1[] = Extrude {0, W, 0} { Curve{1}; Layers{1}; Recombine; };
e2[] = Extrude {0, W, 0} { Curve{2}; Layers{1}; Recombine; };
e3[] = Extrude {0, W, 0} { Curve{3}; Layers{1}; Recombine; };
Coherence;
Physical Surface(21) = {e1[1], e2[1], e3[1]};
Physical Curve(22) = {e1[2]};
Physical Curve(23) = {e3[3]};
Physical Curve(24) = {1, 2, 3};
Physical Curve(25) = {e1[0], e2[0], e3[0]};
