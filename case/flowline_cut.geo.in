// Flowline footprint ending at the steady ice margin (fixed-margin mode: [case] x_end < 1),
// one element wide, refined towards the end. Values are filled in by `ess setup`; Lend = x_end * L.
// The physical-group order (inflow, front, side1, side2) gives Elmer boundaries 1-4, which the
// extruded mesh and steady_template.sif rely on. All groups are selected by position (bounding
// boxes), so nothing depends on gmsh's entity numbering or on the order Extrude returns entities.
Lend = {Lend};
W = {Wmesh};
resb = {BoundaryRes};
resm = {MarginRes};
Point(1) = {0, 0, 0, resb};
Point(2) = {Lend*(1-1/8), 0, 0, resm};
Point(3) = {Lend*(1-1/32), 0, 0, resm/2};
Point(4) = {Lend, 0, 0, resm/2};
Line(1) = {1, 2};
Line(2) = {2, 3};
Line(3) = {3, 4};
Extrude {0, W, 0} { Curve{1}; Curve{2}; Curve{3}; Layers{1}; Recombine; }
Coherence;
e = 1.0;   // m, bounding-box tolerance
Physical Surface(21) = Surface{:};
Physical Curve(22) = Curve In BoundingBox{-e, -e, -e, e, W + e, e};                // inflow, x = 0
Physical Curve(23) = Curve In BoundingBox{Lend - e, -e, -e, Lend + e, W + e, e};   // front, x = Lend
Physical Curve(24) = Curve In BoundingBox{-e, -e, -e, Lend + e, e, e};             // side1, y = 0
Physical Curve(25) = Curve In BoundingBox{-e, W - e, -e, Lend + e, W + e, e};      // side2, y = W
