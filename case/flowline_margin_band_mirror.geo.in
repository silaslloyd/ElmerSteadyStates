// Land counterpart of flowline_marine_gl_mirror.geo.in: the footprint of flowline_margin_band.geo.in (ending at the
// fixed margin Lend, BoundaryRes at the divide, MarginRes from Lend - Lend/6, FineRes over the last 2 FineHalf) as
// UNSTRUCTURED TRIANGLES with a guaranteed mirror symmetry about y = W/2 (the bottom half meshed, the top half its
// reflection: Periodic Surface with an affine reflection, as ElmerStreams' Marine_Term template.geo). Element sizes
// from the points, on the sides and the mid line. Physical groups (inflow, front, side1, side2) give Elmer boundaries
// 1-4 (steady_template.sif). {YElements} is not used.
Mesh.Algorithm = 5;
Mesh.MeshSizeFromPoints = 1;
Mesh.MeshSizeExtendFromBoundary = 1;
Mesh.MeshSizeFromCurvature = 0;
Lend = {Lend};
W = {Wmesh};
resb = {BoundaryRes};
resgl = {MarginRes};
resf = {FineRes};
df = {FineHalf};
// bottom side y = 0
Point(1) = {0, 0, 0, resb};
Point(2) = {Lend - Lend/6, 0, 0, resgl};
Point(3) = {Lend - 2*df, 0, 0, resf};
Point(4) = {Lend, 0, 0, resf};
// mid line y = W/2, from the margin back to the divide
Point(5) = {Lend, W/2, 0, resf};
Point(6) = {Lend - 2*df, W/2, 0, resf};
Point(7) = {Lend - Lend/6, W/2, 0, resgl};
Point(8) = {0, W/2, 0, resb};
// top side y = W, from the margin back to the divide
Point(9) = {Lend, W, 0, resf};
Point(10) = {Lend - 2*df, W, 0, resf};
Point(11) = {Lend - Lend/6, W, 0, resgl};
Point(12) = {0, W, 0, resb};
Line(1) = {1, 2};  Line(2) = {2, 3};  Line(3) = {3, 4};       // y = 0
Line(4) = {4, 5};                                              // x = Lend, lower
Line(5) = {5, 6};  Line(6) = {6, 7};  Line(7) = {7, 8};       // y = W/2
Line(8) = {8, 1};                                              // x = 0, lower
Line(9) = {5, 9};                                              // x = Lend, upper
Line(10) = {9, 10}; Line(11) = {10, 11}; Line(12) = {11, 12}; // y = W
Line(13) = {12, 8};                                            // x = 0, upper
Curve Loop(1) = {1, 2, 3, 4, 5, 6, 7, 8};
Plane Surface(100) = {1};
Curve Loop(2) = {-7, -6, -5, 9, 10, 11, 12, 13};
Plane Surface(200) = {2};
// the top half the mirror image of the bottom half: (x, y, z) -> (x, W - y, z)
Periodic Surface {200} = {100} Affine {1, 0, 0, 0,
                                        0, -1, 0, W,
                                        0, 0, 1, 0,
                                        0, 0, 0, 1};
Physical Surface(21) = {100, 200};
Physical Curve(22) = {8, 13};          // inflow, x = 0
Physical Curve(23) = {4, 9};           // front (the margin), x = Lend
Physical Curve(24) = {1, 2, 3};        // side 1, y = 0
Physical Curve(25) = {10, 11, 12};     // side 2, y = W
