 END SUBROUTINE RenumberDOFs
 !********************************************************************
 
+!------------------------------------------------------------------------------
+!> ESS patch 02: column coarse space for extruded meshes.
+!>
+!> Partition-local preconditioners (ILU, i.e. block Jacobi) cannot see modes that are smooth across many
+!> partitions; on sliding or floating ice such modes are near-free: the column moves as a plug with little
+!> basal drag. This adds a coarse level spanned by vertically uniform modes: per mesh column (the nodes
+!> above one node of the 2D base mesh), a uniform horizontal velocity (u, and v in 3D) and optionally a
+!> uniform pressure. The coarse operator C = P^T A P (Galerkin; roughly the SSA operator of the
+!> current linearisation) is gathered to rank 0 and factorised with MUMPS on a subcommunicator once per
+!> linear solve; each application then is multiplicative:
+!>     x1 = P C^-1 P^T r ;   z = x1 + M^-1 ( r - A x1 ),
+!> M the preconditioner IterSolver set up as usual (ILUn/ILUT/BILU, diagonal or none).
+!> The columns come from the node numbering of Elmer's internal extrusion (layer by layer, the base
+!> nodes' global numbers repeated with an offset per layer), checked on every node. In the
+!> normal-tangential frame the Cartesian modes are rotated per node; constrained (Dirichlet) dofs carry
+!> no coarse component.
+!> Keywords (solver section):
+!>   Linear System Column Coarse = Logical True
+!>   Linear System Column Coarse Pressure = Logical      (default True: plug-flow pressure mode per column)
+!>   Linear System Column Coarse Levels = Integer        (node layers; default: Simulation's Extruded Mesh Levels)
+!>   Linear System Column Coarse Ranks = Integer         (MUMPS ranks for the coarse problem; default 1)
+!>   Linear System Column Coarse Order = Integer         (default 1: the velocity modes are polynomials of degree
+!>       0..Order in the relative height zeta in [0,1] of the node in its column, for u, v AND w, so the coarse
+!>       space holds plug flow that satisfies incompressibility (w linear in depth) and vertical shear;
+!>       0: only uniform u, v, which leaves w and the incompressibility to the local preconditioner)
+!>   Linear System Column Coarse Pre Smoothing = Logical (default False: x1 first, then M^-1 on the rest;
+!>       True: M^-1, coarse correction, M^-1 again, a V(1,1) cycle)
+!>   Linear System Column Coarse Diagnostics = Integer   (applications per solve reported, default 3)
+!>   Linear System Column Coarse Recompute = Integer     (rebuild C and its factors every n-th solve, reuse them in
+!>       between; default 1)
+!>   Columns: by default all. With a selection only those columns get coarse modes (the coarse problem and its
+!>   communication shrink with it): a column is selected where, at any of its nodes,
+!>   Linear System Column Coarse Below Variable = String (e.g. "GroundedMask") < ... Below Value = Real (0.5), or
+!>   Linear System Column Coarse Above Variable = String (e.g. "ColdTempMask") > ... Above Value = Real (0.0);
+!>   Linear System Column Coarse Grow = Integer n adds n rings of neighbouring columns. A column's owner (that of its
+!>   base node) decides; the coarse unknowns are numbered compactly over the selected columns.
+!------------------------------------------------------------------------------
+SUBROUTINE ColumnCoarseSetup( SourceMatrix, SplittedMatrix, ParallelInfo, Solver, nin )
+!------------------------------------------------------------------------------
+  TYPE(Matrix_t) :: SourceMatrix
+  TYPE(SplittedMatrixT) :: SplittedMatrix
+  TYPE(ParallelInfo_t) :: ParallelInfo
+  TYPE(Solver_t), TARGET :: Solver
+  INTEGER :: nin
+
+  TYPE(Mesh_t), POINTER :: Mesh
+  TYPE(ValueList_t), POINTER :: Params
+  INTEGER, POINTER :: Perm(:)
+  INTEGER :: DOFs, dim, nhm, M, Nlev, nn, nbl, Ncol, gmaxl, gmax, nrows, nd, c, r, s, k, j, i, mi, mj, &
+      p, ierr, nlc, W, nloc, ntot, nranks, color, nmiss, II, JJ, lcol, mode, maxp
+  INTEGER, ALLOCATABLE :: rowLcol(:)
+  REAL(KIND=dp), ALLOCATABLE :: Wm(:,:)
+  INTEGER :: nvd, nvm, d, kk
+  REAL(KIND=dp) :: zeta, wv
+  LOGICAL, ALLOCATABLE :: colsel(:), colsel2(:)
+  INTEGER, ALLOCATABLE :: gmap(:), invP(:), selown(:), selall(:), scnt(:), sdis(:)
+  INTEGER :: nsel, nown, ngrow, igr, nrec, q, nd2, g, lc, nall, ib
+  TYPE(Variable_t), POINTER :: mvar
+  REAL(KIND=dp) :: thr, mv
+  LOGICAL :: GotSel, GotV
+  INTEGER, ALLOCATABLE :: gcol(:), rwI(:,:), lcJ(:,:), lcCnt(:), cnts(:), displs(:), Il(:), Jl(:), &
+      Ig(:), Jg(:), tmpJ(:,:)
+  REAL(KIND=dp), ALLOCATABLE :: rwW(:,:), lcV(:,:), Vl(:), Vg(:), tmpV(:,:)
+  LOGICAL, ALLOCATABLE :: hasdiag(:)
+  REAL(KIND=dp) :: vec(3), val, t0
+  LOGICAL :: Found, UseP, Constrained
+  CHARACTER(:), ALLOCATABLE :: str
+  TYPE(NormalTangential_t), POINTER :: NT
+  CHARACTER(*), PARAMETER :: Caller = 'ColumnCoarse'
+!------------------------------------------------------------------------------
+  t0 = MPI_Wtime()
+  Params => Solver % Values
+  Mesh => Solver % Mesh
+  Perm => Solver % Variable % Perm
+
+  ! reuse the coarse operator and its factors between rebuilds (the matrix changes little from solve to solve)
+  CC_nsetup = CC_nsetup + 1
+  nrec = MAX( 1, ListGetInteger( Params, 'Linear System Column Coarse Recompute', Found ) )
+  IF ( CC_ready .AND. nin == CC_nin .AND. MOD(CC_nsetup-1, nrec) /= 0 ) THEN
+    CC_napply = 0; CC_tcoarse = 0.0_dp
+    RETURN
+  END IF
+  DOFs = Solver % Variable % DOFs
+  dim = DOFs - 1
+  IF ( dim < 2 .OR. dim > 3 ) CALL Fatal(Caller, 'expects a velocity-pressure variable (2 or 3 velocity '// &
+      'components + pressure), got DOFs = '//I2S(DOFs))
+  nhm = dim - 1
+  UseP = ListGetLogical( Params, 'Linear System Column Coarse Pressure', Found )
+  IF ( .NOT. Found ) UseP = .TRUE.
+  CC_order = ListGetInteger( Params, 'Linear System Column Coarse Order', Found )
+  IF ( .NOT. Found ) CC_order = 1
+  CC_order = MAX( 0, CC_order )
+  nvd = dim                           ! velocity directions in the coarse space: u, v, w ...
+  IF ( CC_order == 0 ) nvd = nhm      ! ... or only the horizontal ones for uniform modes
+  nvm = nvd * (CC_order + 1)          ! mode (d, kk) = (d-1)*(Order+1) + kk + 1, kk the degree in zeta
+  M = nvm
+  IF ( UseP ) M = M + 1               ! pressure: mode M, uniform
+  CC_ns = MAX( 1, nvm )               ! coarse components per dof at most
+  CC_prepost = ListGetLogical( Params, 'Linear System Column Coarse Pre Smoothing', Found )
+
+  ! the preconditioner the wrapper applies after the coarse correction (IterSolver builds it)
+  str = ListGetString( Params, 'Linear System Preconditioning', Found )
+  IF ( .NOT. Found ) str = 'none'
+  IF ( str == 'none' ) THEN
+    CC_inner = 0
+  ELSE IF ( str == 'diagonal' ) THEN
+    CC_inner = 1
+  ELSE IF ( SEQL(str, 'ilu') .OR. SEQL(str, 'bilu') ) THEN
+    CC_inner = 2
+  ELSE
+    CALL Fatal(Caller, 'works with Linear System Preconditioning = none, diagonal, ILUn, ILUT or BILUn, not '//TRIM(str))
+  END IF
+
+  ! the MPI layout: rank 0 of the active communicator gathers the coarse matrix and is MUMPS's host
+  IF ( .NOT. CC_commset ) THEN
+    CC_comm = ParEnv % ActiveComm
+    CALL MPI_Comm_rank( CC_comm, CC_myrank, ierr )
+    CALL MPI_Comm_size( CC_comm, nranks, ierr )
+    CC_nsub = ListGetInteger( Params, 'Linear System Column Coarse Ranks', Found )
+    IF ( .NOT. Found ) CC_nsub = 1
+    CC_nsub = MAX( 1, MIN( CC_nsub, nranks ) )
+    CC_ndiag = ListGetInteger( Params, 'Linear System Column Coarse Diagnostics', Found )
+    IF ( .NOT. Found ) CC_ndiag = 3
+    CC_member = ( CC_myrank < CC_nsub )
+    color = MPI_UNDEFINED
+    IF ( CC_member ) color = 1
+    CALL MPI_Comm_split( CC_comm, color, CC_myrank, CC_subcomm, ierr )
+    CC_commset = .TRUE.
+  END IF
+  CALL MPI_Comm_size( CC_comm, nranks, ierr )
+
+  ! columns: Elmer's extrusion numbers the nodes layer by layer
+  Nlev = ListGetInteger( Params, 'Linear System Column Coarse Levels', Found )
+  IF ( .NOT. Found ) Nlev = ListGetInteger( CurrentModel % Simulation, 'Extruded Mesh Levels', Found )
+  IF ( .NOT. Found ) THEN
+    Nlev = ListGetInteger( CurrentModel % Simulation, 'Extruded Mesh Layers', Found ) + 1
+  END IF
+  IF ( .NOT. Found .OR. Nlev < 2 ) CALL Fatal(Caller, 'number of node layers unknown: give '// &
+      '"Linear System Column Coarse Levels" (needs a mesh from Elmer''s internal extrusion)')
+  nn = Mesh % NumberOfNodes
+  IF ( MOD(nn, Nlev) /= 0 ) CALL Fatal(Caller, 'local node count '//I2S(nn)//' is not a multiple of the '// &
+      I2S(Nlev)//' node layers: not an internally extruded mesh?')
+  nbl = nn / Nlev
+  gmaxl = MAXVAL( Mesh % ParallelInfo % GlobalDOFs(1:nn) )
+  CALL MPI_Allreduce( gmaxl, gmax, 1, MPI_INTEGER, MPI_MAX, CC_comm, ierr )
+  IF ( MOD(gmax, Nlev) /= 0 ) CALL Fatal(Caller, 'largest global node number '//I2S(gmax)// &
+      ' is not a multiple of the '//I2S(Nlev)//' node layers')
+  Ncol = gmax / Nlev
+  ALLOCATE( gcol(nn) )
+  DO nd = 1, nn
+    gcol(nd) = MOD( Mesh % ParallelInfo % GlobalDOFs(nd) - 1, Ncol ) + 1
+  END DO
+  DO nd = 1, nn
+    IF ( gcol(nd) /= gcol( MOD(nd-1, nbl) + 1 ) ) CALL Fatal(Caller, &
+        'node numbering is not layer by layer (node '//I2S(nd)//'): needs Elmer''s internal extrusion')
+  END DO
+  nrows = SourceMatrix % NumberOfRows
+
+  ! the columns that get coarse modes
+  ALLOCATE( colsel(nbl), colsel2(nbl) )
+  colsel = .TRUE.
+  GotSel = .FALSE.
+  DO ib = 1, 2
+    IF ( ib == 1 ) THEN
+      str = ListGetString( Params, 'Linear System Column Coarse Below Variable', GotV )
+      thr = ListGetCReal( Params, 'Linear System Column Coarse Below Value', Found )
+      IF ( .NOT. Found ) thr = 0.5_dp
+    ELSE
+      str = ListGetString( Params, 'Linear System Column Coarse Above Variable', GotV )
+      thr = ListGetCReal( Params, 'Linear System Column Coarse Above Value', Found )
+      IF ( .NOT. Found ) thr = 0.0_dp
+    END IF
+    IF ( .NOT. GotV ) CYCLE
+    mvar => VariableGet( Mesh % Variables, str )
+    IF ( .NOT. ASSOCIATED( mvar ) ) THEN
+      CALL Warn(Caller, 'no variable "'//TRIM(str)//'": this column selection is ignored')
+      CYCLE
+    END IF
+    IF ( .NOT. GotSel ) colsel = .FALSE.
+    GotSel = .TRUE.
+    DO nd = 1, nn
+      q = nd
+      IF ( ASSOCIATED( mvar % Perm ) ) THEN
+        q = 0
+        IF ( nd <= SIZE( mvar % Perm ) ) q = mvar % Perm(nd)
+      END IF
+      IF ( q <= 0 .OR. q > SIZE( mvar % Values ) ) CYCLE
+      mv = mvar % Values(q)
+      lc = MOD(nd-1, nbl) + 1
+      IF ( ib == 1 .AND. mv < thr ) colsel(lc) = .TRUE.
+      IF ( ib == 2 .AND. mv > thr ) colsel(lc) = .TRUE.
+    END DO
+  END DO
+  ! grow by rings of neighbouring columns (through the matrix graph)
+  ngrow = ListGetInteger( Params, 'Linear System Column Coarse Grow', Found )
+  IF ( GotSel .AND. ngrow > 0 ) THEN
+    maxp = 0
+    DO nd = 1, nn
+      maxp = MAX( maxp, Perm(nd) )
+    END DO
+    ALLOCATE( invP(maxp) )
+    invP = 0
+    DO nd = 1, nn
+      IF ( Perm(nd) > 0 ) invP(Perm(nd)) = nd
+    END DO
+    DO igr = 1, ngrow
+      colsel2 = colsel
+      DO nd = 1, nn
+        p = Perm(nd)
+        IF ( p <= 0 ) CYCLE
+        IF ( .NOT. colsel( MOD(nd-1, nbl) + 1 ) ) CYCLE
+        r = DOFs * (p-1) + 1
+        DO k = SourceMatrix % Rows(r), SourceMatrix % Rows(r+1) - 1
+          s = SourceMatrix % Cols(k)
+          IF ( s > DOFs * maxp ) CYCLE
+          nd2 = invP( (s-1)/DOFs + 1 )
+          IF ( nd2 > 0 ) colsel2( MOD(nd2-1, nbl) + 1 ) = .TRUE.
+        END DO
+      END DO
+      colsel = colsel2
+    END DO
+    DEALLOCATE( invP )
+  END IF
+  ! compact global numbering of the selected columns, as their owners (base node) selected them
+  nown = 0
+  ALLOCATE( selown(MAX(nbl,1)), scnt(nranks), sdis(nranks) )
+  DO lc = 1, nbl
+    IF ( colsel(lc) .AND. Mesh % ParallelInfo % NeighbourList(lc) % Neighbours(1) == ParEnv % MyPE ) THEN
+      nown = nown + 1
+      selown(nown) = gcol(lc)
+    END IF
+  END DO
+  CALL MPI_Allgather( nown, 1, MPI_INTEGER, scnt, 1, MPI_INTEGER, CC_comm, ierr )
+  sdis(1) = 0
+  DO i = 2, nranks
+    sdis(i) = sdis(i-1) + scnt(i-1)
+  END DO
+  nall = sdis(nranks) + scnt(nranks)
+  ALLOCATE( selall(MAX(nall,1)) )
+  CALL MPI_Allgatherv( selown, nown, MPI_INTEGER, selall, scnt, sdis, MPI_INTEGER, CC_comm, ierr )
+  ALLOCATE( gmap(Ncol) )
+  gmap = 0
+  DO i = 1, nall
+    gmap( selall(i) ) = 1
+  END DO
+  nsel = 0
+  DO g = 1, Ncol
+    IF ( gmap(g) > 0 ) THEN
+      nsel = nsel + 1
+      gmap(g) = nsel
+    END IF
+  END DO
+  DO lc = 1, nbl
+    IF ( gmap( gcol(lc) ) == 0 ) colsel(lc) = .FALSE.
+  END DO
+  DEALLOCATE( selown, selall, scnt, sdis, colsel2 )
+  IF ( nsel == 0 ) CALL Fatal(Caller, 'no column selected for the coarse level (check the Below/Above Variable)')
+  CC_nsel = nsel
+  CC_ncoarse = M * nsel
+
+  ! the coarse weights of every row of the local matrix: rwI = local coarse index M*(lcol-1)+mode
+  maxp = 0
+  DO nd = 1, nn
+    maxp = MAX( maxp, Perm(nd) )
+  END DO
+  IF ( DOFs * maxp > nrows ) CALL Fatal(Caller, 'matrix smaller than the variable')
+  ALLOCATE( rwI(CC_ns,nrows), rwW(CC_ns,nrows), rowLcol(nrows) )
+  rwI = 0; rwW = 0.0_dp; rowLcol = 0
+  NT => Solver % NormalTangential
+  DO nd = 1, nn
+    p = Perm(nd)
+    IF ( p <= 0 ) CYCLE
+    lcol = MOD(nd-1, nbl) + 1
+    zeta = REAL( (nd-1)/nbl, dp ) / REAL( Nlev-1, dp )     ! relative height of the node's layer
+    k = 0
+    IF ( NT % NormalTangentialNOFNodes > 0 ) THEN
+      IF ( ASSOCIATED( NT % BoundaryReorder ) ) THEN
+        IF ( nd <= SIZE( NT % BoundaryReorder ) ) k = NT % BoundaryReorder(nd)
+      END IF
+    END IF
+    DO c = 1, DOFs
+      r = DOFs * (p-1) + c
+      rowLcol(r) = lcol
+      IF ( .NOT. colsel(lcol) ) CYCLE      ! no coarse modes in this column (its owner may still give some)
+      Constrained = .FALSE.
+      IF ( ALLOCATED( SourceMatrix % ConstrainedDOF ) ) Constrained = SourceMatrix % ConstrainedDOF(r)
+      IF ( Constrained ) CYCLE
+      IF ( c <= dim ) THEN
+        vec = 0.0_dp
+        IF ( k > 0 ) THEN
+          ! rotated row: component c is (n, t1, t2)(c) . u; a Cartesian mode e_d maps to its projection vec(d)
+          IF ( dim == 3 ) THEN
+            SELECT CASE( c )
+            CASE( 1 ); vec = NT % BoundaryNormals(k,1:3)
+            CASE( 2 ); vec = NT % BoundaryTangent1(k,1:3)
+            CASE( 3 ); vec = NT % BoundaryTangent2(k,1:3)
+            END SELECT
+          ELSE
+            IF ( c == 1 ) THEN
+              vec(1) = NT % BoundaryNormals(k,1); vec(2) = NT % BoundaryNormals(k,2)
+            ELSE
+              vec(1) = -NT % BoundaryNormals(k,2); vec(2) = NT % BoundaryNormals(k,1)
+            END IF
+          END IF
+        ELSE
+          vec(c) = 1.0_dp
+        END IF
+        j = 0
+        DO d = 1, nvd
+          IF ( ABS(vec(d)) <= 1.0e-6_dp ) CYCLE     ! e.g. a wall's tangents' tiny component along its normal
+          DO kk = 0, CC_order
+            wv = vec(d)
+            IF ( kk > 0 ) wv = wv * zeta**kk
+            IF ( ABS(wv) <= 1.0e-6_dp ) CYCLE
+            j = j + 1
+            rwI(j,r) = M*(lcol-1) + (d-1)*(CC_order+1) + kk + 1; rwW(j,r) = wv
+          END DO
+        END DO
+      ELSE IF ( UseP ) THEN
+        rwI(1,r) = M*(lcol-1) + M; rwW(1,r) = 1.0_dp
+      END IF
+    END DO
+  END DO
+
+  ! Every dof takes the weights its OWNER computed: partitions sharing a node can differ in what they know about it
+  ! (Dirichlet flags, normal-tangential rotation), and P must be one operator for the assembly below (all local
+  ! rows) and the application (owned rows) to agree, i.e. for C to be exactly P^T A P
+  ALLOCATE( Wm(nrows,M) )
+  Wm = 0.0_dp
+  DO r = 1, nrows
+    IF ( ParallelInfo % NeighbourList(r) % Neighbours(1) /= ParEnv % MyPE ) CYCLE
+    DO mi = 1, CC_ns
+      II = rwI(mi,r)
+      IF ( II == 0 ) EXIT
+      Wm(r, MOD(II-1,M)+1) = rwW(mi,r)
+    END DO
+  END DO
+  DO mode = 1, M
+    CALL ExchangeSourceVec( SourceMatrix, SplittedMatrix, ParallelInfo, Wm(:,mode) )
+  END DO
+  rwI = 0; rwW = 0.0_dp
+  DO r = 1, nrows
+    IF ( rowLcol(r) == 0 ) CYCLE
+    j = 0
+    DO mode = 1, M
+      IF ( ABS(Wm(r,mode)) > 1.0e-6_dp ) THEN
+        j = j + 1
+        IF ( j > CC_ns ) CALL Fatal(Caller, 'more coarse modes on one dof than expected')
+        rwI(j,r) = M*(rowLcol(r)-1) + mode; rwW(j,r) = Wm(r,mode)
+      END IF
+    END DO
+  END DO
+  DEALLOCATE( Wm, rowLcol )
+
+  ! local part of P^T A P (the local matrices sum to the global one), accumulated per local coarse row
+  nlc = M * nbl
+  W = 32
+  ALLOCATE( lcJ(W,nlc), lcV(W,nlc), lcCnt(nlc) )
+  lcCnt = 0
+  DO r = 1, nrows
+    IF ( rwI(1,r) == 0 ) CYCLE
+    DO k = SourceMatrix % Rows(r), SourceMatrix % Rows(r+1) - 1
+      s = SourceMatrix % Cols(k)
+      IF ( s > nrows ) CYCLE
+      IF ( rwI(1,s) == 0 ) CYCLE
+      val = SourceMatrix % Values(k)
+      IF ( val == 0.0_dp ) CYCLE
+      DO mi = 1, CC_ns
+        II = rwI(mi,r)
+        IF ( II == 0 ) EXIT
+        DO mj = 1, CC_ns
+          JJ = rwI(mj,s)
+          IF ( JJ == 0 ) EXIT
+          DO j = 1, lcCnt(II)
+            IF ( lcJ(j,II) == JJ ) EXIT
+          END DO
+          IF ( j > lcCnt(II) ) THEN
+            IF ( j > W ) THEN   ! grow the row width
+              ALLOCATE( tmpJ(2*W,nlc), tmpV(2*W,nlc) )
+              tmpJ(1:W,:) = lcJ; tmpV(1:W,:) = lcV
+              CALL MOVE_ALLOC( tmpJ, lcJ ); CALL MOVE_ALLOC( tmpV, lcV )
+              W = 2 * W
+            END IF
+            lcCnt(II) = j
+            lcJ(j,II) = JJ
+            lcV(j,II) = 0.0_dp
+          END IF
+          lcV(j,II) = lcV(j,II) + rwW(mi,r) * val * rwW(mj,s)
+        END DO
+      END DO
+    END DO
+  END DO
+
+  ! to global coarse numbering, gathered on rank 0
+  nloc = SUM( lcCnt )
+  ALLOCATE( Il(MAX(nloc,1)), Jl(MAX(nloc,1)), Vl(MAX(nloc,1)) )
+  i = 0
+  DO II = 1, nlc
+    DO j = 1, lcCnt(II)
+      i = i + 1
+      lcol = (II-1)/M + 1; mode = MOD(II-1, M) + 1
+      Il(i) = M*(gmap(gcol(lcol))-1) + mode
+      lcol = (lcJ(j,II)-1)/M + 1; mode = MOD(lcJ(j,II)-1, M) + 1
+      Jl(i) = M*(gmap(gcol(lcol))-1) + mode
+      Vl(i) = lcV(j,II)
+    END DO
+  END DO
+  DEALLOCATE( lcJ, lcV, lcCnt )
+  ALLOCATE( cnts(nranks), displs(nranks) )
+  CALL MPI_Gather( nloc, 1, MPI_INTEGER, cnts, 1, MPI_INTEGER, 0, CC_comm, ierr )
+  ntot = 0
+  IF ( CC_myrank == 0 ) THEN
+    displs(1) = 0
+    DO i = 2, nranks
+      displs(i) = displs(i-1) + cnts(i-1)
+    END DO
+    ntot = displs(nranks) + cnts(nranks)
+  END IF
+  k = 1
+  IF ( CC_myrank == 0 ) k = ntot + CC_ncoarse
+  ALLOCATE( Ig(k), Jg(k), Vg(k) )
+  CALL MPI_Gatherv( Il, nloc, MPI_INTEGER, Ig, cnts, displs, MPI_INTEGER, 0, CC_comm, ierr )
+  CALL MPI_Gatherv( Jl, nloc, MPI_INTEGER, Jg, cnts, displs, MPI_INTEGER, 0, CC_comm, ierr )
+  CALL MPI_Gatherv( Vl, nloc, MPI_DOUBLE_PRECISION, Vg, cnts, displs, MPI_DOUBLE_PRECISION, 0, CC_comm, ierr )
+  DEALLOCATE( Il, Jl, Vl )
+
+  ! coarse dofs nobody touches (fully constrained columns) get a unit diagonal: their right-hand side is zero
+  nmiss = 0
+  IF ( CC_myrank == 0 ) THEN
+    ALLOCATE( hasdiag(CC_ncoarse) )
+    hasdiag = .FALSE.
+    DO i = 1, ntot
+      IF ( Ig(i) == Jg(i) ) hasdiag(Ig(i)) = .TRUE.
+    END DO
+    DO i = 1, CC_ncoarse
+      IF ( .NOT. hasdiag(i) ) THEN
+        nmiss = nmiss + 1
+        Ig(ntot+nmiss) = i; Jg(ntot+nmiss) = i; Vg(ntot+nmiss) = 1.0_dp
+      END IF
+    END DO
+    DEALLOCATE( hasdiag )
+  END IF
+
+#ifdef HAVE_MUMPS
+  IF ( CC_member ) THEN
+    IF ( .NOT. CC_mumpsinit ) THEN
+      CC_id % COMM = CC_subcomm
+      CC_id % SYM = 0
+      CC_id % PAR = 1
+      CC_id % JOB = -1
+      CALL DMUMPS( CC_id )
+      CC_mumpsinit = .TRUE.
+    END IF
+    IF ( CC_myrank == 0 ) THEN
+      IF ( CC_havemat ) DEALLOCATE( CC_id % IRN, CC_id % JCN, CC_id % A )
+      CC_id % N = CC_ncoarse
+      CC_id % NZ = ntot + nmiss
+      CC_id % NNZ = INT( ntot + nmiss, KIND=8 )   ! MUMPS >= 5.1 reads NNZ when set
+      ALLOCATE( CC_id % IRN(ntot+nmiss), CC_id % JCN(ntot+nmiss), CC_id % A(ntot+nmiss) )
+      CC_id % IRN = Ig(1:ntot+nmiss)
+      CC_id % JCN = Jg(1:ntot+nmiss)
+      CC_id % A = Vg(1:ntot+nmiss)
+      CC_havemat = .TRUE.
+    END IF
+    CC_id % ICNTL(1) = 6     ! errors
+    CC_id % ICNTL(2) = -1
+    CC_id % ICNTL(3) = -1
+    CC_id % ICNTL(4) = 1
+    CC_id % ICNTL(5) = 0     ! assembled (duplicates are summed)
+    CC_id % ICNTL(18) = 0    ! centralised matrix
+    CC_id % ICNTL(21) = 0    ! centralised solution
+    CC_id % ICNTL(14) = 60
+    ! coarse modes without stiffness (e.g. a mode no dof really carries) give null pivots: detect them and
+    ! return the solution with those components zero instead of failing
+    CC_id % ICNTL(24) = 1
+    CC_id % CNTL(3) = 1.0e-10_dp
+    CC_id % JOB = 4          ! analysis + factorisation
+    CALL DMUMPS( CC_id )
+    IF ( CC_id % INFOG(1) < 0 .AND. CC_myrank == 0 ) THEN
+      CALL Warn(Caller, 'MUMPS factorisation of the coarse matrix failed, INFOG(1) = '// &
+          I2S(CC_id % INFOG(1))//', INFOG(2) = '//I2S(CC_id % INFOG(2))//': retrying with a small diagonal shift')
+    END IF
+    IF ( CC_id % INFOG(1) < 0 ) THEN
+      ! a tiny shift of the diagonal (1e-8 of the largest entry) makes singular coarse directions harmless
+      IF ( CC_myrank == 0 ) THEN
+        val = 1.0e-8_dp * MAXVAL( ABS( CC_id % A ) )
+        DO i = 1, ntot + nmiss
+          IF ( CC_id % IRN(i) == CC_id % JCN(i) ) CC_id % A(i) = CC_id % A(i) + &
+              SIGN( val, CC_id % A(i) )
+        END DO
+      END IF
+      CC_id % JOB = 2          ! factorisation (the analysis is kept)
+      CALL DMUMPS( CC_id )
+    END IF
+    CC_off = ( CC_id % INFOG(1) < 0 )
+    IF ( CC_myrank == 0 .AND. CC_off ) CALL Warn(Caller, 'the coarse factorisation failed again (INFOG(1) = '// &
+        I2S(CC_id % INFOG(1))//'): this solve runs without the coarse level')
+    IF ( CC_myrank == 0 .AND. .NOT. CC_off .AND. CC_id % INFOG(28) > 0 ) CALL Info(Caller, &
+        'null pivots in the coarse matrix: '//I2S(CC_id % INFOG(28))//' (those coarse components are left out)', Level=3)
+  END IF
+  ! every rank must know whether the coarse level is on (only the MUMPS ranks saw the result)
+  CALL MPI_Bcast( CC_off, 1, MPI_LOGICAL, 0, CC_comm, ierr )
+#else
+  CALL Fatal(Caller, 'needs Elmer built with MUMPS')
+#endif
+  DEALLOCATE( Ig, Jg, Vg, cnts, displs )
+
+  ! prolongation / restriction weights on the rows the iteration works with (the owned rows, in order)
+  IF ( ALLOCATED(CC_ci) ) DEALLOCATE( CC_ci, CC_w, CC_x1, CC_r1, CC_z1, CC_s )
+  CC_nin = nin
+  ALLOCATE( CC_ci(CC_ns,MAX(nin,1)), CC_w(CC_ns,MAX(nin,1)), CC_x1(MAX(nin,1)), CC_r1(MAX(nin,1)), &
+      CC_z1(MAX(nin,1)), CC_s(MAX(nin,1)) )
+  CC_ci = 0; CC_w = 0.0_dp
+  j = 0
+  DO r = 1, nrows
+    IF ( ParallelInfo % NeighbourList(r) % Neighbours(1) /= ParEnv % MyPE ) CYCLE
+    j = j + 1
+    IF ( j > nin ) CALL Fatal(Caller, 'more owned rows than the iteration has')
+    DO mi = 1, CC_ns
+      II = rwI(mi,r)
+      IF ( II == 0 ) EXIT
+      lcol = (II-1)/M + 1; mode = MOD(II-1, M) + 1
+      CC_ci(mi,j) = M*(gmap(gcol(lcol))-1) + mode
+      CC_w(mi,j) = rwW(mi,r)
+    END DO
+  END DO
+  IF ( j /= nin ) CALL Fatal(Caller, 'owned rows '//I2S(j)//' /= iteration size '//I2S(nin))
+  DEALLOCATE( rwI, rwW, gcol, gmap, colsel )
+
+  IF ( ASSOCIATED(CC_rhs) ) THEN
+    IF ( SIZE(CC_rhs) /= CC_ncoarse ) DEALLOCATE( CC_rhs )
+  END IF
+  IF ( .NOT. ASSOCIATED(CC_rhs) ) ALLOCATE( CC_rhs(CC_ncoarse) )
+  CC_napply = 0; CC_tcoarse = 0.0_dp
+  CC_ready = .TRUE.
+
+  IF ( CC_myrank == 0 ) THEN
+    WRITE( Message, '(A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,I0,A,L1,A,F8.3,A)' ) 'columns ', nsel, ' of ', Ncol, &
+        ' x modes ', M, ' = ', CC_ncoarse, ' coarse unknowns (order ', CC_order, '), ', ntot, &
+        ' entries gathered, MUMPS on ', CC_nsub, ' ranks, pre-smoothing ', CC_prepost, ', setup ', MPI_Wtime()-t0, ' s'
+    CALL Info(Caller, Message, Level=3)
+  END IF
+!------------------------------------------------------------------------------
+END SUBROUTINE ColumnCoarseSetup
+!------------------------------------------------------------------------------
+
+
+!------------------------------------------------------------------------------
+!> ESS patch 02: x = P C^-1 P^T r (collective: restriction summed on rank 0, MUMPS solve, broadcast). On
+!> diagnostic calls also returns |P^T r| (rank 0).
+!------------------------------------------------------------------------------
+SUBROUTINE ColumnCoarseCorrect( r, x, n, diag, rcn )
+!------------------------------------------------------------------------------
+  INTEGER :: n
+  REAL(KIND=dp) :: r(*), x(*), rcn
+  LOGICAL :: diag
+  INTEGER :: j, m, i, ierr
+!------------------------------------------------------------------------------
+  CC_rhs = 0.0_dp
+  DO j = 1, n
+    DO m = 1, CC_ns
+      i = CC_ci(m,j)
+      IF ( i == 0 ) EXIT
+      CC_rhs(i) = CC_rhs(i) + CC_w(m,j) * r(j)
+    END DO
+  END DO
+  IF ( CC_myrank == 0 ) THEN
+    CALL MPI_Reduce( MPI_IN_PLACE, CC_rhs, CC_ncoarse, MPI_DOUBLE_PRECISION, MPI_SUM, 0, CC_comm, ierr )
+  ELSE
+    CALL MPI_Reduce( CC_rhs, CC_dummy, CC_ncoarse, MPI_DOUBLE_PRECISION, MPI_SUM, 0, CC_comm, ierr )
+  END IF
+  rcn = 0.0_dp
+  IF ( diag .AND. CC_myrank == 0 ) rcn = SQRT( SUM( CC_rhs**2 ) )
+#ifdef HAVE_MUMPS
+  IF ( CC_member ) THEN
+    IF ( CC_myrank == 0 ) THEN
+      CC_id % RHS => CC_rhs
+      CC_id % NRHS = 1
+      CC_id % LRHS = CC_ncoarse
+    END IF
+    CC_id % JOB = 3
+    CALL DMUMPS( CC_id )
+    IF ( CC_id % INFOG(1) < 0 .AND. CC_myrank == 0 ) CALL Warn('ColumnCoarse', 'MUMPS coarse solve failed, INFOG(1) = '// &
+        I2S(CC_id % INFOG(1))//': no coarse correction in this application')
+    IF ( CC_id % INFOG(1) < 0 .AND. CC_myrank == 0 ) CC_rhs = 0.0_dp
+  END IF
+#endif
+  CALL MPI_Bcast( CC_rhs, CC_ncoarse, MPI_DOUBLE_PRECISION, 0, CC_comm, ierr )
+  DO j = 1, n
+    x(j) = 0.0_dp
+    DO m = 1, CC_ns
+      i = CC_ci(m,j)
+      IF ( i == 0 ) EXIT
+      x(j) = x(j) + CC_w(m,j) * CC_rhs(i)
+    END DO
+  END DO
+!------------------------------------------------------------------------------
+END SUBROUTINE ColumnCoarseCorrect
+!------------------------------------------------------------------------------
+
+
+!------------------------------------------------------------------------------
+!> ESS patch 02: the local preconditioner IterSolver built, u = M^-1 v.
+!------------------------------------------------------------------------------
+SUBROUTINE ColumnCoarseLocal( u, v, ipar, n )
+!------------------------------------------------------------------------------
+  INTEGER, DIMENSION(*) :: ipar
+  REAL(KIND=dp), DIMENSION(*) :: u, v
+  INTEGER :: n
+!------------------------------------------------------------------------------
+  SELECT CASE( CC_inner )
+  CASE( 1 )
+    CALL CRS_DiagPrecondition( u, v, ipar )
+  CASE( 2 )
+    CALL CRS_LUPrecondition( u, v, ipar )
+  CASE DEFAULT
+    u(1:n) = v(1:n)
+  END SELECT
+!------------------------------------------------------------------------------
+END SUBROUTINE ColumnCoarseLocal
+!------------------------------------------------------------------------------
+
+
+!------------------------------------------------------------------------------
+!> ESS patch 02: apply the two-level preconditioner to v:
+!>   default:            x1 = P C^-1 P^T v,  u = x1 + M^-1 (v - A x1)
+!>   Pre Smoothing:      z0 = M^-1 v, s = v - A z0,  x1 = z0 + P C^-1 P^T s,  u = x1 + M^-1 (v - A x1)
+!------------------------------------------------------------------------------
+SUBROUTINE ColumnCoarsePrec( u, v, ipar )
+!------------------------------------------------------------------------------
+  INTEGER, DIMENSION(*) :: ipar
+  REAL(KIND=dp), DIMENSION(*) :: u, v
+  INTEGER :: n, j, m, i, ierr
+  REAL(KIND=dp) :: t0, sq(5), rcn, rc1n
+  LOGICAL :: diag
+!------------------------------------------------------------------------------
+  n = HUTI_NDIM
+  IF ( n /= CC_nin ) CALL Fatal('ColumnCoarse', 'vector size '//I2S(n)//' /= setup size '//I2S(CC_nin))
+  diag = ( CC_napply < CC_ndiag )
+
+  ! optional pre-smoothing: CC_z1 = M^-1 v, CC_s = v - A CC_z1 (else CC_z1 = 0, CC_s = v)
+  IF ( CC_prepost ) THEN
+    CALL ColumnCoarseLocal( CC_z1, v, ipar, n )
+    CALL SParMatrixVector( CC_z1, CC_r1, ipar )
+    DO j = 1, n
+      CC_s(j) = v(j) - CC_r1(j)
+    END DO
+  ELSE
+    DO j = 1, n
+      CC_z1(j) = 0.0_dp
+      CC_s(j) = v(j)
+    END DO
+  END IF
+
+  ! coarse correction of the current residual CC_s: CC_x1 = P C^-1 P^T CC_s, residual after it CC_r1
+  t0 = MPI_Wtime()
+  IF ( CC_off ) THEN
+    CC_x1(1:n) = 0.0_dp
+    diag = .FALSE.
+  ELSE
+    CALL ColumnCoarseCorrect( CC_s, CC_x1, n, diag, rcn )
+  END IF
+  CC_tcoarse = CC_tcoarse + MPI_Wtime() - t0
+  CALL SParMatrixVector( CC_x1, CC_r1, ipar )
+  DO j = 1, n
+    CC_r1(j) = CC_s(j) - CC_r1(j)
+  END DO
+
+  IF ( diag ) THEN
+    ! consistency: an exact Galerkin step leaves no coarse component, P^T (s - A x1) = 0
+    CC_rhs = 0.0_dp
+    DO j = 1, n
+      DO m = 1, CC_ns
+        i = CC_ci(m,j)
+        IF ( i == 0 ) EXIT
+        CC_rhs(i) = CC_rhs(i) + CC_w(m,j) * CC_r1(j)
+      END DO
+    END DO
+    IF ( CC_myrank == 0 ) THEN
+      CALL MPI_Reduce( MPI_IN_PLACE, CC_rhs, CC_ncoarse, MPI_DOUBLE_PRECISION, MPI_SUM, 0, CC_comm, ierr )
+      rc1n = SQRT( SUM( CC_rhs**2 ) )
+      IF ( rcn > 0.0_dp ) THEN
+        WRITE( Message, '(A,I0,A,ES10.3,A)' ) 'apply ', CC_napply+1, ': |P^T (s - A x1)| / |P^T s| = ', rc1n/rcn, &
+            '  (Galerkin consistency, should be ~1e-12)'
+        CALL Info('ColumnCoarse', Message, Level=3)
+      END IF
+    ELSE
+      CALL MPI_Reduce( CC_rhs, CC_dummy, CC_ncoarse, MPI_DOUBLE_PRECISION, MPI_SUM, 0, CC_comm, ierr )
+    END IF
+  END IF
+
+  ! approximation so far z1 + x1 (residual CC_r1), then the local preconditioner on that residual
+  DO j = 1, n
+    CC_x1(j) = CC_z1(j) + CC_x1(j)
+  END DO
+  CALL ColumnCoarseLocal( CC_z1, CC_r1, ipar, n )
+  DO j = 1, n
+    u(j) = CC_x1(j) + CC_z1(j)
+  END DO
+
+  ! diagnostics: |v|, |s| (after pre-smoothing), |r1| (after the coarse step), |x1|, |final local correction|
+  IF ( diag ) THEN
+    sq = 0.0_dp
+    DO j = 1, n
+      sq(1) = sq(1) + v(j)**2
+      sq(2) = sq(2) + CC_s(j)**2
+      sq(3) = sq(3) + CC_r1(j)**2
+      sq(4) = sq(4) + CC_x1(j)**2
+      sq(5) = sq(5) + CC_z1(j)**2
+    END DO
+    CALL MPI_Allreduce( MPI_IN_PLACE, sq, 5, MPI_DOUBLE_PRECISION, MPI_SUM, CC_comm, ierr )
+    sq = SQRT( sq )
+    IF ( sq(1) > 0.0_dp .AND. sq(2) > 0.0_dp ) THEN
+      WRITE( Message, '(A,I0,A,ES10.3,A,ES10.3,A,ES10.3,A,ES10.3,A,ES10.3)' ) 'apply ', CC_napply+1, ': |r| ', &
+          sq(1), '  |s|/|r| ', sq(2)/sq(1), '  |s - A x1|/|s| ', sq(3)/sq(2), '  |x| before local ', sq(4), &
+          '  |local correction| ', sq(5)
+      CALL Info('ColumnCoarse', Message, Level=3)
+    END IF
+  END IF
+  CC_napply = CC_napply + 1
+!------------------------------------------------------------------------------
+END SUBROUTINE ColumnCoarsePrec
+!------------------------------------------------------------------------------
+
+
 END MODULE SParIterSolve
 
 !> \}
