+  CONTAINS
+
+    ! ESS patch (BFBt) ---------------------------------------------------------------------------------------------
+    ! z = K^-1 (C - B A Bt) K^-1 r on the packed pressure vectors (r, z of size offset(NoVar+1) - offset(NoVar))
+    SUBROUTINE BFBtApply( r, z )
+      REAL(KIND=dp), INTENT(IN) :: r(:)
+      REAL(KIND=dp), INTENT(OUT) :: z(:)
+      REAL(KIND=dp), ALLOCATABLE :: y(:), t(:)
+      ALLOCATE( y(SIZE(r)), t(SIZE(r)) )
+      CALL BFBtKinv( r, y )
+      CALL BFBtMid( y, t )
+      CALL BFBtKinv( t, z )
+      DEALLOCATE( y, t )
+    END SUBROUTINE BFBtApply
+
+    ! The monolithic product s = K_full w on packed vectors of size ntot
+    SUBROUTINE BFBtMono( w, s )
+      REAL(KIND=dp), INTENT(IN) :: w(:)
+      REAL(KIND=dp), INTENT(OUT) :: s(:)
+      INTEGER :: lipar(50)
+      lipar = 0
+      lipar(3) = ntot
+      CALL BlockMatrixVectorProdMono( w, s, lipar )
+    END SUBROUTINE BFBtMono
+
+    ! out = K y = C y - B (Bt y)
+    SUBROUTINE BFBtK( y, out )
+      REAL(KIND=dp), INTENT(IN) :: y(:)
+      REAL(KIND=dp), INTENT(OUT) :: out(:)
+      REAL(KIND=dp), ALLOCATABLE :: w(:), s(:), cy(:)
+      ALLOCATE( w(ntot), s(ntot), cy(SIZE(y)) )
+      w = 0.0_dp
+      w(p0+1:ntot) = y
+      CALL BFBtMono( w, s )
+      cy = s(p0+1:ntot)
+      w = 0.0_dp
+      w(1:p0) = s(1:p0)
+      CALL BFBtMono( w, s )
+      out = cy - s(p0+1:ntot)
+      DEALLOCATE( w, s, cy )
+    END SUBROUTINE BFBtK
+
+    ! out = (C - B A Bt) y
+    SUBROUTINE BFBtMid( y, out )
+      REAL(KIND=dp), INTENT(IN) :: y(:)
+      REAL(KIND=dp), INTENT(OUT) :: out(:)
+      REAL(KIND=dp), ALLOCATABLE :: w(:), s(:), cy(:)
+      ALLOCATE( w(ntot), s(ntot), cy(SIZE(y)) )
+      w = 0.0_dp
+      w(p0+1:ntot) = y
+      CALL BFBtMono( w, s )          ! s = [Bt y ; C y]
+      cy = s(p0+1:ntot)
+      w = 0.0_dp
+      w(1:p0) = s(1:p0)
+      CALL BFBtMono( w, s )          ! s = [A Bt y ; B Bt y]
+      w = 0.0_dp
+      w(1:p0) = s(1:p0)
+      CALL BFBtMono( w, s )          ! s = [A A Bt y ; B A Bt y]
+      out = cy - s(p0+1:ntot)
+      DEALLOCATE( w, s, cy )
+    END SUBROUTINE BFBtMid
+
+    ! y = (-K) x with the assembled -K (packed vectors)
+    SUBROUTINE BFBtKasm( x, y )
+      REAL(KIND=dp), INTENT(IN) :: x(:)
+      REAL(KIND=dp), INTENT(OUT) :: y(:)
+      REAL(KIND=dp), ALLOCATABLE, TARGET :: xc(:), yc(:)
+      INTEGER :: m
+      ! buffers of the matrix's local size (as BlockMatrixVectorProd's MaxSize): the parallel product takes and
+      ! returns the packed (owned) values in their leading entries but works on the full local length
+      m = MAX( BFBtKmat % NumberOfRows, SIZE(x), SIZE(y) )
+      ALLOCATE( xc(m), yc(m) )
+      xc = 0.0_dp
+      xc(1:SIZE(x)) = x
+      yc = 0.0_dp
+      IF( isParallel ) THEN
+        CALL ParallelMatrixVector( BFBtKmat, xc, yc )
+      ELSE
+        CALL CRS_MatrixVectorMultiply( BFBtKmat, xc, yc )
+      END IF
+      y = yc(1:SIZE(y))
+      DEALLOCATE( xc, yc )
+    END SUBROUTINE BFBtKasm
+
+    ! The global dot product of packed vectors (each rank holds its own dofs)
+    FUNCTION BFBtDot( a, b ) RESULT( d )
+      REAL(KIND=dp), INTENT(IN) :: a(:), b(:)
+      REAL(KIND=dp) :: d
+      d = SUM( a * b )
+      IF( isParallel ) d = ParallelReduction( d )
+    END FUNCTION BFBtDot
+
+    ! -K = -C + sum_c B_c Bt_c (positive definite; D = I: the scaled system), the products partition-local (exact in serial; at the
+    ! partition interfaces only approximate: it is only the preconditioner of the K solves, whose products are exact)
+    SUBROUTINE BFBtBuildK()
+      TYPE(Matrix_t), POINTER :: Cm, Bc, Btc
+      TYPE(Variable_t), POINTER :: SaveVar
+      INTEGER :: c, ii, jj, kk, j2, np
+      REAL(KIND=dp) :: val
+      IF( ASSOCIATED( BFBtKmat ) ) CALL FreeMatrix( BFBtKmat )
+      Cm => TotMatrix % Submatrix(NoVar,NoVar) % Mat
+      np = Cm % NumberOfRows
+      BFBtKmat => AllocateMatrix()
+      BFBtKmat % FORMAT = MATRIX_LIST
+      CALL List_AddToMatrixElement( BFBtKmat % ListMatrix, np, np, 0.0_dp )
+      DO ii = 1, np
+        DO jj = Cm % Rows(ii), Cm % Rows(ii+1)-1
+          CALL List_AddToMatrixElement( BFBtKmat % ListMatrix, ii, Cm % Cols(jj), -Cm % Values(jj) )
+        END DO
+      END DO
+      DO c = 1, NoVar-1
+        Bc => TotMatrix % Submatrix(NoVar,c) % Mat
+        Btc => TotMatrix % Submatrix(c,NoVar) % Mat
+        IF( .NOT. ASSOCIATED(Bc) .OR. .NOT. ASSOCIATED(Btc) ) CYCLE
+        IF( Bc % NumberOfRows == 0 .OR. Btc % NumberOfRows == 0 ) CYCLE
+        DO ii = 1, Bc % NumberOfRows
+          DO jj = Bc % Rows(ii), Bc % Rows(ii+1)-1
+            kk = Bc % Cols(jj)
+            val = Bc % Values(jj)
+            IF( val == 0.0_dp ) CYCLE
+            IF( kk > Btc % NumberOfRows ) CYCLE
+            DO j2 = Btc % Rows(kk), Btc % Rows(kk+1)-1
+              CALL List_AddToMatrixElement( BFBtKmat % ListMatrix, ii, Btc % Cols(j2), val * Btc % Values(j2) )
+            END DO
+          END DO
+        END DO
+      END DO
+      CALL List_toCRSMatrix( BFBtKmat )
+      IF( isParallel ) THEN
+        ! the parallel structures as BlockSolveInt makes them for the block matrices: from the block's variable
+        SaveVar => Solver % Variable
+        Solver % Variable => TotMatrix % SubVector(NoVar) % Var
+        CALL ParallelInitMatrix( Solver, BFBtKmat )
+        IF( ASSOCIATED( BFBtKmat % ParMatrix ) ) CALL SetMatrixParEnv( BFBtKmat )
+        Solver % Variable => SaveVar
+      END IF
+      CALL Info('BlockMatrixPrec','BFBt: assembled -K = B Bt - C ('//I2S(SIZE(BFBtKmat % Values))//' entries)',Level=6)
+    END SUBROUTINE BFBtBuildK
+
+    ! z = (-K)^-1 q approximately: the assembled -K solved for q with the "block NN:" keywords (one AMG V-cycle)
+    SUBROUTINE BFBtPrecC( q, z )
+      REAL(KIND=dp), INTENT(IN) :: q(:)
+      REAL(KIND=dp), INTENT(OUT) :: z(:)
+      TYPE(Matrix_t), POINTER :: Cm
+      TYPE(Variable_t), POINTER :: CVar
+      INTEGER, POINTER :: CPerm(:)
+      REAL(KIND=dp), ALLOCATABLE :: bl(:), xl(:)
+      Cm => BFBtKmat
+      CVar => TotMatrix % SubVector(NoVar) % Var
+      ALLOCATE( bl(Cm % NumberOfRows), xl(Cm % NumberOfRows) )
+      bl = 0.0_dp
+      xl = 0.0_dp
+      IF( isParallel ) THEN
+        CPerm => TotMatrix % Submatrix(NoVar,NoVar) % ParPerm
+        bl(CPerm) = q
+      ELSE
+        bl(1:SIZE(q)) = q
+      END IF
+      CALL ListPushNameSpace('block '//I2S(11*NoVar)//':')
+      IF( NoNestedScaling ) CALL ListAddLogical( Params,'Linear System Skip Scaling',.TRUE.)
+      CALL SolveLinearSystem( Cm, bl, xl, CVar % Norm, CVar % DOFs, Solver )
+      IF( NoNestedScaling ) CALL ListAddLogical( Params,'Linear System Skip Scaling',.FALSE.)
+      CALL ListPopNameSpace()
+      IF( isParallel ) THEN
+        z = xl(CPerm)
+      ELSE
+        z = xl(1:SIZE(z))
+      END IF
+      DEALLOCATE( bl, xl )
+    END SUBROUTINE BFBtPrecC
+
+    ! x = K^-1 r: flexible CG on (-K) x = -r, preconditioned by the assembled K (BFBtPrecC)
+    SUBROUTINE BFBtKinv( r, x )
+      REAL(KIND=dp), INTENT(IN) :: r(:)
+      REAL(KIND=dp), INTENT(OUT) :: x(:)
+      REAL(KIND=dp), ALLOCATABLE :: res(:), zz(:), zold(:), pp(:), qq(:)
+      REAL(KIND=dp) :: rz, rz2, alpha, beta, r0, rn
+      INTEGER :: it, m
+      m = SIZE(r)
+      ALLOCATE( res(m), zz(m), zold(m), pp(m), qq(m) )
+      x = 0.0_dp
+      res = -r
+      r0 = SQRT( BFBtDot( res, res ) )
+      IF( r0 <= TINY(r0) ) THEN
+        DEALLOCATE( res, zz, zold, pp, qq )
+        RETURN
+      END IF
+      CALL BFBtPrecC( res, zz )
+      pp = zz
+      zold = zz
+      rz = BFBtDot( res, zz )
+      DO it = 1, BFBtMaxIter
+        IF( BFBtAsmK ) THEN
+          CALL BFBtKasm( pp, qq )      ! qq = (-K) pp, the assembled -K
+        ELSE
+          CALL BFBtK( pp, qq )
+          qq = -qq
+        END IF
+        alpha = rz / BFBtDot( pp, qq )
+        x = x + alpha * pp
+        res = res - alpha * qq
+        rn = SQRT( BFBtDot( res, res ) )
+        BFBtCount = BFBtCount + 1
+        IF( BFBtOut > 0 ) THEN
+          IF( MOD(it,BFBtOut) == 0 ) THEN
+            WRITE( Message,'(A,I0,A,ES12.4)') 'BFBt K solve: ', it, ' ', rn / r0
+            CALL Info('BlockMatrixPrec',Message,Level=4)
+          END IF
+        END IF
+        IF( rn <= BFBtTol * r0 ) EXIT
+        CALL BFBtPrecC( res, zz )
+        rz2 = BFBtDot( res, zz - zold )      ! flexible (Polak-Ribiere): the preconditioner may vary
+        beta = rz2 / rz
+        rz = BFBtDot( res, zz )
+        pp = zz + beta * pp
+        zold = zz
+      END DO
+      DEALLOCATE( res, zz, zold, pp, qq )
+    END SUBROUTINE BFBtKinv
+
   END SUBROUTINE BlockMatrixPrec
 
 
