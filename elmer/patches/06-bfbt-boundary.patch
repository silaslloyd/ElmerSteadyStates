+    ! W_c (patch 06, Elman & Tuminaro 2009): 1, except BFBtEps at the velocity dofs of component c coupled by B_c
+    ! (B_c(j,v) /= 0) to a pressure node j on a boundary to which component c is TANGENTIAL (the boundary's normal
+    ! not along axis c). The boundaries: all boundary elements of the mesh, the normal's dominant axis.
+    ! Consistent across partitions (the flags summed over the shared dofs).
+    SUBROUTINE BFBtWeights( c, Bc, Ad, wv )
+      INTEGER :: c
+      TYPE(Matrix_t), POINTER :: Bc, Ad
+      REAL(KIND=dp), ALLOCATABLE :: wv(:)
+      TYPE(Mesh_t), POINTER :: Mesh
+      TYPE(Element_t), POINTER :: Elm
+      INTEGER, POINTER :: PVPerm(:)
+      INTEGER, ALLOCATABLE :: pflag(:)
+      REAL(KIND=dp), ALLOCATABLE :: ind(:), pind(:)
+      REAL(KIND=dp) :: a(3), b(3), nrm(3)
+      INTEGER :: t, k, n1, n2, n3, ax, j, jj, nv, nn
+      IF( NoVar - 1 > 3 ) CALL Fatal('BlockMatrixPrec','BFBt boundary weight: the velocity blocks must be the components 1..3')
+      Mesh => Solver % Mesh
+      PVPerm => TotMatrix % SubVector(NoVar) % Var % Perm
+      ALLOCATE( pflag(Bc % NumberOfRows) )
+      pflag = 0
+      DO t = Mesh % NumberOfBulkElements + 1, Mesh % NumberOfBulkElements + Mesh % NumberOfBoundaryElements
+        Elm => Mesh % Elements(t)
+        nn = Elm % TYPE % NumberOfNodes
+        IF( nn < 3 ) CYCLE
+        n1 = Elm % NodeIndexes(1)
+        n2 = Elm % NodeIndexes(2)
+        n3 = Elm % NodeIndexes(3)
+        a = [ Mesh % Nodes % x(n2) - Mesh % Nodes % x(n1), Mesh % Nodes % y(n2) - Mesh % Nodes % y(n1), &
+              Mesh % Nodes % z(n2) - Mesh % Nodes % z(n1) ]
+        b = [ Mesh % Nodes % x(n3) - Mesh % Nodes % x(n1), Mesh % Nodes % y(n3) - Mesh % Nodes % y(n1), &
+              Mesh % Nodes % z(n3) - Mesh % Nodes % z(n1) ]
+        nrm = [ a(2)*b(3) - a(3)*b(2), a(3)*b(1) - a(1)*b(3), a(1)*b(2) - a(2)*b(1) ]
+        ax = MAXLOC( ABS(nrm), 1 )
+        IF( ax == c ) CYCLE                 ! component c is normal to this boundary: not adjusted
+        DO k = 1, nn
+          j = PVPerm( Elm % NodeIndexes(k) )
+          IF( j > 0 .AND. j <= SIZE(pflag) ) pflag(j) = 1
+        END DO
+      END DO
+      ! a shared pressure node on a boundary: flagged on every partition sharing it
+      IF( isParallel ) THEN
+        ALLOCATE( pind(SIZE(pflag)) )
+        pind = REAL( pflag, dp )
+        IF( BFBtCanSum( TotMatrix % Submatrix(NoVar,NoVar) % Mat ) ) THEN
+          CALL ParallelSumVector( TotMatrix % Submatrix(NoVar,NoVar) % Mat, pind )
+        ELSE
+          CALL Warn('BlockMatrixPrec','BFBt boundary weight: pressure flags not summed over partitions')
+        END IF
+        WHERE( pind > 0.0_dp ) pflag = 1
+        DEALLOCATE( pind )
+      END IF
+      nv = Ad % NumberOfRows
+      ALLOCATE( ind(nv), wv(nv) )
+      ind = 0.0_dp
+      DO j = 1, Bc % NumberOfRows
+        IF( pflag(j) == 0 ) CYCLE
+        DO jj = Bc % Rows(j), Bc % Rows(j+1)-1
+          IF( Bc % Values(jj) == 0.0_dp ) CYCLE
+          IF( Bc % Cols(jj) <= nv ) ind( Bc % Cols(jj) ) = 1.0_dp
+        END DO
+      END DO
+      IF( isParallel ) THEN
+        IF( BFBtCanSum( Ad ) ) THEN
+          CALL ParallelSumVector( Ad, ind )
+        ELSE
+          CALL Warn('BlockMatrixPrec','BFBt boundary weight: velocity flags not summed over partitions')
+        END IF
+      END IF
+      wv = 1.0_dp
+      WHERE( ind > 0.0_dp ) wv = BFBtEps
+      DEALLOCATE( pflag, ind )
+    END SUBROUTINE BFBtWeights
+
+    ! the parallel structures ParallelSumVector needs are there
+    FUNCTION BFBtCanSum( A ) RESULT( ok )
+      TYPE(Matrix_t), POINTER :: A
+      LOGICAL :: ok
+      ok = ASSOCIATED( A )
+      IF( ok ) ok = ASSOCIATED( A % ParallelInfo ) .AND. ASSOCIATED( A % ParMatrix )
+      IF( ok ) ok = ASSOCIATED( A % ParMatrix % SplittedMatrix )
+    END FUNCTION BFBtCanSum
 
   END SUBROUTINE BlockMatrixPrec
 
