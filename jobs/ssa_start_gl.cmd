#!/bin/bash
#SBATCH --output=./slurms/ssa_start_gl_%j.out
#SBATCH --job-name=ssastartgl
#SBATCH --ntasks=64
#SBATCH --time=2-00:00:00
#
# jobs/ssa_start.cmd with the grounding line IMPOSED instead of solved for: the SSA steady profile for a chosen grounding
# line position (diag/ssa_profile.py --gl-km), the Stokes + free-surface contact transient (jobs/gl_branch.py) from it. The
# steady SSA grounding line is 585.57 km, the Stokes transient from it retreats towards ~550 km; starting at ~549 km shows
# whether the grounding line then stays (steady) or drifts, and from which side the two runs converge. Own work dir
# (work/gl_ssa_gl<GL>), own tables (case/marine_ics_ssa_gl<GL>) and config (configs/flowline_gl_fine_ssa_gl<GL>.toml, generated by
# jobs/ssa_start_gl_cfg.py): the running jobs, work/gl_ssa and case/marine_ics_ssa are not touched.
#
#   GL=549 sbatch jobs/ssa_start_gl.cmd
#   GL=549 RES=125 TAG=gl549 ARGS="--max-chunks 100" sbatch jobs/ssa_start_gl.cmd
# GL (km, default 549), RES (m, default 125), TAG (default gl<GL>), ARGS (more options of gl_branch.py; default "--max-chunks 100").
# Every step is resumable: resubmitting resumes (raise --max-chunks to continue past the cap).
set -e
cd "${SLURM_SUBMIT_DIR:-$(dirname "$0")/..}"
mkdir -p slurms
export ELMER_MODULE=${ELMER_MODULE:-elmerfem/2026-10-28} ELMER_PREFIX=${ELMER_PREFIX:-/SCRATCH/$USER/elmer/install2}
bash periodic_test/run_gl_ess.cmd build
module load "$ELMER_MODULE"
export PATH=$ELMER_PREFIX/bin:$PATH ELMER_HOME=$ELMER_PREFIX
export ELMER_LIB=$ELMER_PREFIX/share/elmersolver/lib ELMER_SOLVER_HOME=$ELMER_PREFIX/share/elmersolver
export LD_LIBRARY_PATH=$ELMER_PREFIX/lib:$ELMER_PREFIX/lib/elmersolver:$ELMER_PREFIX/share/elmersolver/lib:$LD_LIBRARY_PATH
export LIBRARY_PATH=$ELMER_PREFIX/lib/elmersolver:$ELMER_PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}
export ESS_MPIRUN="mpirun -np {n} --bind-to none"
unset ESS_SLIDING ESS_HEAT_LIMITER ESS_SEA_SPRING_DT ESS_STRAIN_HEAT_POSITIVE ESS_NO_CONVECTION
export ESS_CONTACT_FUNCTION=elmerstreams
GL=${GL:-549}
RES=${RES:-125}
TAG=${TAG:-gl$GL}
CFG=configs/flowline_gl_fine_ssa_gl$GL.toml
W=work/gl_ssa_gl$GL
TABLES=case/marine_ics_ssa_gl$GL
mkdir -p $W
python3 jobs/ssa_start_gl_cfg.py --gl-km $GL --out $CFG
[ -f $W/ssa_profile.csv ] || python3 diag/ssa_profile.py --params case/parameters_fine2x.lua --gl-km $GL --out $W/ssa_profile
python3 jobs/ssa_tables.py $W/ssa_profile.csv $TABLES
if [ ! -f $W/start1.npz ]; then
    python3 -u -m ess setup $CFG
    python3 -u -m ess init $CFG --out $W/state0.npz
    python3 -u jobs/shelf_break.py $W/state0.npz $W/start1.npz --strip-divide-r-km 1520.8 --r-break-km 450 --factor 30 --width-km 10 --force
fi
python3 - <<PY
import sys
sys.path.insert(0, ".")
from ess.statefile import load_state
from ess.spectrum import gl_position
s = load_state("$W/start1.npz")
print(f"start state: grounding line {gl_position(s.frozen, s.diag) / 1e3:.2f} km (imposed $GL km)")
PY
python3 -u jobs/gl_branch.py --config $CFG --from $W/start1.npz --res $RES --tag $TAG --force ${ARGS:---max-chunks 100}
