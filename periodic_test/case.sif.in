!! Periodic-BC / partitioning test: a parallel-sided slab on a flat bed, square footprint, periodic on
!! all four sides (x = 0 <-> x = L, y = 0 <-> y = W), driven along x by gravity tilted by the slope
!! (z normal to the bed). Stokes (Newtonian, temperature-dependent linear sliding) and heat, optionally a
!! free surface. Nothing depends on x or y, so the exact discrete solution is horizontally uniform: any
!! horizontal structure is an error of the partitioning, the periodic BCs or the linear solvers.
!! Filled in by run_tests.py (__NAME__ placeholders; the solver blocks are assembled there).

!---LUA BEGIN
! assert(loadfile('params.lua'))()
!---LUA END

Header
  Mesh DB "__MESH_DIR__" "footprint"
End

Constants
  Gravity(4) = 0 0 -1 9.81
  Stefan Boltzmann = Real 6.78E-08
End

Simulation
  Coordinate System = "Cartesian 3D"
__SIM_TYPE__
  Steady State Max Iterations = __SS_ITERS__
  Steady State Min Iterations = 1
  Extruded Mesh Levels = Integer __NZ1__
  Extruded Max Coordinate = Real __H__
  Output Intervals = __OUT_EVERY__
  max output level = 3
End

Body 1
  Name = "ice"
  Equation = 1
  Material = 1
  Body Force = 1
  Initial Condition = 1
End

Initial Condition 1
  ! linear from Tb0 at the bed to Ts at the surface
  Temperature = Variable Coordinate 3
    Real Lua "Ts + (Tb0 - Ts) * (1 - tx[0] / H)"
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
  Velocity 3 = Real 0.0
  Pressure = Real 0.0
End

Body Force 1
  ! acceleration (multiplied by the density): gravity tilted by the slope, z normal to the bed
  Flow BodyForce 1 = Real #gravity*sina
  Flow BodyForce 2 = Real 0.0
  Flow BodyForce 3 = Real #-gravity*cosa
End

Material 1
  Name = "ice"
  Density = Real #rhoi
  Viscosity = Real #eta
  Heat Capacity = Real #heatcapacity
  Heat Conductivity = Real #heatconductivity
  Cauchy = Logical True
__FS_MATERIAL__
End

Equation 1
  Name = "ice"
  Active Solvers(__NACTIVE__) = __ACTIVE__
  Convection = "Computed"
  Flow Solution Name = String "Flow Solution"
End
__FS_BODIES__
__SOLVERS__
!---------------- boundary conditions ----------------
! periodic pairs: x = L is the image of x = 0 (BC 2 -> 1), y = W the image of y = 0 (BC 4 -> 3)

Boundary Condition 1
  Name = "x = 0 (master)"
  Target Boundaries(1) = 1
End

Boundary Condition 2
  Name = "x = L (periodic image of x = 0)"
  Target Boundaries(1) = 2
  Periodic BC = 1
  Periodic BC Translate(3) = Real __L__ 0.0 0.0
__PERIODIC_VARS__
End

Boundary Condition 3
  Name = "y = 0 (master)"
  Target Boundaries(1) = 3
End

Boundary Condition 4
  Name = "y = W (periodic image of y = 0)"
  Target Boundaries(1) = 4
  Periodic BC = 3
  Periodic BC Translate(3) = Real 0.0 __W__ 0.0
__PERIODIC_VARS__
End

Boundary Condition 5
  Name = "bed"
  Target Boundaries(1) = 5
  Normal-Tangential Velocity = Logical True
  Velocity 1 = Real 0.0
  Slip Coefficient 2 = Variable Temperature
    Real Lua "slip(tx[0])"
  Slip Coefficient 3 = Variable Temperature
    Real Lua "slip(tx[0])"
__BED_HEAT__
__FS_BED__
End

Boundary Condition 6
  Name = "surface"
  Target Boundaries(1) = 6
  Temperature = Real #Ts
__FS_TOP__
End
