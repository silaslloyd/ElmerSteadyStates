! Rotational periodic Stokes test (elmer/ESSIncompressibleNS.F90 ESSRotPeriodicFrames). An annular sector of ice,
! flat bed (no slip), surface sloping down radially, the inner arc held (no slip), the outer arc free; gravity-driven
! radial flow. The exact solution is axisymmetric: no azimuthal velocity, v_r(r, z) the same at every angle.
! @CASE@ = periodic: side 2 the rotational periodic image of side 1 (radial, azimuthal and vertical velocity tied);
!          walls:    both sides free-slip walls (zero normal = azimuthal velocity: the exact axisymmetric solution);
!          cartesian: side 2 tied to side 1 component by component in vx, vy, vz (the wrong, translation-style tie).
! Made by run_rotper.sh (sed).

Header
  Mesh DB "." "sector"
End

Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Extruded Mesh Levels = Integer 6
  Output Intervals = 1
  Max Output Level = 5
End

Constants
  Gravity(4) = 0 0 -1 9.81
End

Body 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Material 1
  Density = Real 917.0
  Viscosity = Real 1.0e14
End

Body Force 1
  Flow BodyForce 3 = Real -9.81
End

Equation 1
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = "MapCoordinate"
  Procedure = "StructuredMeshMapper" "StructuredMeshMapper"
  Active Coordinate = Integer 3
  Exec Solver = "Before Simulation"
End

Solver 2
  Equation = "Stokes"
  Procedure = "@LIB@" "IncompressibleNSSolver"
  Variable = Flow Solution[Velocity:3 Pressure:1]
  Element = "p:1 b:4"
  Bubbles in Global System = Logical False
  Stokes Flow = Logical True
  Nonlinear System Max Iterations = 1
  Linear System Solver = Direct
  Linear System Direct Method = @DIRECT@
End

Solver 3
  Equation = "Output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "rotper_@CASE@"
  Output Format = String "vtu"
  Exec Solver = "After Simulation"
End

! side 1 (master, -ANGLE/2)
Boundary Condition 1
  Target Boundaries(1) = 1
@SIDE1@
End

! side 2 (slave, +ANGLE/2)
Boundary Condition 2
  Target Boundaries(1) = 2
@SIDE2@
End

! inner arc: held
Boundary Condition 3
  Target Boundaries(1) = 3
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
  Velocity 3 = Real 0.0
End

! outer arc: free
Boundary Condition 4
  Target Boundaries(1) = 4
End

! bed (extruded: the next free boundary index): flat, no slip
Boundary Condition 5
  Target Boundaries(1) = 5
  Bottom Surface = Real 0.0
  Velocity 1 = Real 0.0
  Velocity 2 = Real 0.0
  Velocity 3 = Real 0.0
End

! surface: 1000 m at R0, falling 5 m per km outwards
Boundary Condition 6
  Target Boundaries(1) = 6
  Top Surface = Variable Coordinate 1, Coordinate 2
    Real MATC "1000 - 0.005 * (sqrt(tx(0)^2 + tx(1)^2) - @R0@)"
End
